{
  "schemaVersion": 1,
  "id": "bluemap_live",
  "version": "${version}",

  "name": "BlueMap Live",
  "description": "BlueMap Live: an unofficial fork of BlueMap with live 3d player-models. A 3d-map of your Minecraft worlds view-able in your browser using three.js (WebGL)",
  "authors": [
    "Blue (TBlueF, Lukas Rieger)"
  ],
  "contact": {
    "homepage": "https://github.com/Creepers1312/BlueMap-Live",
    "sources": "https://github.com/Creepers1312/BlueMap-Live"
  },
  "license": "MIT",
  "icon": "assets/bluemap/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "de.bluecolored.bluemap.fabric.FabricMod"
    ]
  },

  "mixins": [
    "bluemap_live.mixins.json"
  ],

  "depends": {
    "java": ">=${java_version}",
    "minecraft": ">=${minecraft_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api-base": "*"
  },

  "suggests": {}
}
